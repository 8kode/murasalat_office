{
  "doctype": "DocType",
  "name": "Murasalat Referral",
  "module": "Murasalat Office",
  "custom": 0,
  "istable": 1,
  "editable_grid": 0,
  "engine": "InnoDB",
  "field_order": [
    "referral_number",
    "recipient_type",
    "recipient_organization",
    "recipient_user",
    "direction",
    "importance",
    "due_date",
    "instructions",
    "private_referral",
    "paper_copy",
    "cc_copy",
    "follow_up",
    "status",
    "sent_on",
    "received_by",
    "received_on",
    "completed_by",
    "completed_on",
    "referral_todo",
    "reminder_sent_on",
    "manager_escalated_on",
    "final_escalated_on"
  ],
  "fields": [
    {
      "fieldname": "referral_number",
      "label": "Referral Number",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "recipient_type",
      "label": "Recipient Type",
      "fieldtype": "Select",
      "options": "Organization\nUser",
      "default": "Organization",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "recipient_organization",
      "label": "To Organization",
      "fieldtype": "Link",
      "options": "Murasalat Organization Entity",
      "depends_on": "eval:doc.recipient_type==\"Organization\"",
      "mandatory_depends_on": "eval:doc.recipient_type==\"Organization\"",
      "in_list_view": 1
    },
    {
      "fieldname": "recipient_user",
      "label": "To User",
      "fieldtype": "Link",
      "options": "User",
      "depends_on": "eval:doc.recipient_type==\"User\"",
      "mandatory_depends_on": "eval:doc.recipient_type==\"User\"",
      "in_list_view": 1
    },
    {
      "fieldname": "direction",
      "label": "Direction",
      "fieldtype": "Link",
      "options": "Murasalat Referral Direction",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "importance",
      "label": "Importance",
      "fieldtype": "Link",
      "options": "Murasalat Importance Level",
      "reqd": 1
    },
    {
      "fieldname": "due_date",
      "label": "Due Date",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "instructions",
      "label": "Instructions to Recipient",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "private_referral",
      "label": "Private",
      "fieldtype": "Check"
    },
    {
      "fieldname": "paper_copy",
      "label": "Paper Correspondence",
      "fieldtype": "Check"
    },
    {
      "fieldname": "cc_copy",
      "label": "Copy",
      "fieldtype": "Check"
    },
    {
      "fieldname": "follow_up",
      "label": "For Follow-up",
      "fieldtype": "Check"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Pending\nSent\nReceived\nIn Progress\nCompleted\nRejected\nReturned\nOverdue\nWithdrawn\nCancelled",
      "default": "Pending",
      "in_list_view": 1
    },
    {
      "fieldname": "sent_on",
      "label": "Sent On",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "received_by",
      "label": "Received By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "received_on",
      "label": "Received On",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "completed_by",
      "label": "Completed By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "completed_on",
      "label": "Completed On",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "referral_todo",
      "label": "Assignment ToDo",
      "fieldtype": "Link",
      "options": "ToDo",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "reminder_sent_on",
      "label": "Reminder Sent On",
      "fieldtype": "Datetime",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "manager_escalated_on",
      "label": "Manager Escalated On",
      "fieldtype": "Datetime",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "final_escalated_on",
      "label": "Final Escalated On",
      "fieldtype": "Datetime",
      "read_only": 1,
      "hidden": 1
    }
  ],
  "permissions": []
}
