+{# قالب طباعة تقارير الإدارة — A4 ملوّن، عربي من اليمين إلى اليسار.
+
+   كيف يصل هذا القالب إلى الشاشة: يختاره المستخدم في نافذة الطباعة على التقرير، فيقرأه
+   الخادم بـ frappe.desk.query_report.get_print_format_data ويعيد html و css، ثم يرسمه
+   الإطار في المتصفح. فالقالب لا يستدعي شيئًا من الخادم ولا يستعمل frappe.*: يقرأ ما يمرّره
+   الإطار إليه ويرسمه.
+
+   المتغيّرات المتاحة (من query_report.js::pdf_report):
+     title, subtitle, filters, data, columns, original_data, report, print_settings
+
+   subtitle هو سطر الفلاتر الذي يبنيه الإطار حين يضع المستخدم علامة "Include filters" في
+   نافذة الطباعة. و"الإجمالي" هو آخر صف في التقارير الثلاثة، فيُبرَز بخلفية مميّزة.
+#}
+{% set NUMBER_TYPES = ["Int", "Float", "Currency", "Percent"] %}
+{% set TOTAL_WORDS = ["Total", "الإجمالي"] %}
+
+<div class="mo-rpt" dir="rtl">
+
+  <table class="mo-rpt-head">
+    <tr>
+      <td class="mo-rpt-head-main">
+        <div class="mo-rpt-title">{{ title }}</div>
+        <div class="mo-rpt-rule"></div>
+      </td>
+      <td class="mo-rpt-head-side">
+        <div class="mo-rpt-mark">نظام المعاملات</div>
+        <div class="mo-rpt-mark-sub">Murasalat Office</div>
+      </td>
+    </tr>
+  </table>
+
+  {% if subtitle %}
+  <div class="mo-rpt-filters">{{ subtitle | safe }}</div>
+  {% endif %}
+
+  <table class="mo-rpt-grid">
+    <thead>
+      <tr>
+        {% for column in columns %}
+        <th{% if column.fieldtype in NUMBER_TYPES %} class="num"{% endif %}>{{ column.label }}</th>
+        {% endfor %}
+      </tr>
+    </thead>
+    <tbody>
+      {% if data %}
+        {% for row in data %}
+        {% set first = row[columns[0].fieldname] %}
+        <tr{% if first in TOTAL_WORDS %} class="total"{% elif loop.index0 % 2 %} class="alt"{% endif %}>
+          {% for column in columns %}
+          {% set value = row[column.fieldname] %}
+          <td{% if column.fieldtype in NUMBER_TYPES %} class="num"{% endif %}>
+            {% if value or value == 0 %}{{ value }}{% else %}<span class="mo-dash">—</span>{% endif %}
+          </td>
+          {% endfor %}
+        </tr>
+        {% endfor %}
+      {% else %}
+        <tr>
+          <td colspan="{{ columns | length }}" class="mo-empty">لا توجد بيانات في هذه الفترة.</td>
+        </tr>
+      {% endif %}
+    </tbody>
+  </table>
+
+  <div class="mo-rpt-foot">
+    <span class="mo-rpt-foot-brand">نظام المعاملات — Murasalat Office</span>
+    <span class="mo-rpt-foot-note">هذا التقرير محسوب وفق صلاحيات مُصدِره، ولا يتضمّن سجلًا لا يملك قراءته.</span>
+  </div>
+
+</div>
+
+<style>
+  @page { size: A4 portrait; margin: 10mm; }
+
+  .mo-rpt {
+    direction: rtl;
+    text-align: right;
+    font-family: "Noto Naskh Arabic", "Amiri", "Traditional Arabic", "Segoe UI", Tahoma, Arial, sans-serif;
+    color: #17231f;
+    font-size: 10pt;
+    line-height: 1.6;
+  }
+
+  table.mo-rpt-head { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
+  table.mo-rpt-head td { border: none; padding: 0; vertical-align: bottom; }
+  .mo-rpt-title { font-size: 17pt; font-weight: bold; color: #123c35; }
+  .mo-rpt-rule { height: 2.6pt; background: #123c35; margin-top: 1.4mm; width: 100%; }
+  .mo-rpt-head-side { text-align: left; width: 42mm; }
+  .mo-rpt-mark { font-size: 11pt; font-weight: bold; color: #2f6b5f; }
+  .mo-rpt-mark-sub { font-size: 8pt; color: #7b8b86; direction: ltr; text-align: left; }
+
+  .mo-rpt-filters {
+    border: 0.6pt solid #c9d8d3;
+    background: #f4f8f6;
+    border-right: 3pt solid #c9821f;
+    padding: 2mm 3mm;
+    margin: 0 0 3.5mm 0;
+    font-size: 8.8pt;
+    color: #3c4a45;
+  }
+  .mo-rpt-filters .filter-row { display: block; }
+  .mo-rpt-filters strong { color: #123c35; }
+
+  table.mo-rpt-grid { width: 100%; border-collapse: collapse; }
+  .mo-rpt-grid thead th {
+    background: #123c35;
+    color: #ffffff;
+    font-size: 9.2pt;
+    font-weight: bold;
+    text-align: right;
+    padding: 2mm 2.2mm;
+    border: 0.6pt solid #123c35;
+  }
+  .mo-rpt-grid thead th.num { text-align: center; }
+  .mo-rpt-grid tbody td {
+    border: 0.6pt solid #d6e2de;
+    padding: 1.8mm 2.2mm;
+    vertical-align: middle;
+  }
+  .mo-rpt-grid tbody td.num {
+    text-align: center;
+    direction: ltr;
+    font-weight: bold;
+    font-family: "DejaVu Sans Mono", Consolas, monospace;
+    font-size: 9pt;
+  }
+  .mo-rpt-grid tbody tr.alt td { background: #f7faf9; }
+  .mo-rpt-grid tbody tr.total td {
+    background: #eef3f1;
+    border-top: 1.4pt solid #123c35;
+    color: #123c35;
+    font-weight: bold;
+  }
+  .mo-dash { color: #b3c2bd; }
+  .mo-empty {
+    text-align: center;
+    color: #7b8b86;
+    padding: 8mm 0;
+    font-size: 10pt;
+  }
+
+  .mo-rpt-foot {
+    margin-top: 4mm;
+    padding-top: 1.6mm;
+    border-top: 0.6pt solid #c9d8d3;
+    font-size: 7.8pt;
+    color: #55655f;
+    display: table;
+    width: 100%;
+  }
+  .mo-rpt-foot-brand { display: table-cell; text-align: right; font-weight: bold; color: #123c35; }
+  .mo-rpt-foot-note { display: table-cell; text-align: left; }
+</style>
