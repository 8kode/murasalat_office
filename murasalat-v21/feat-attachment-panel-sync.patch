 murasalat_office/patches.txt                  |  7 ++++-
 .../patches/v0_23_index_record_attachments.py |  1 +
 .../tests/test_attachment_native_index.py     | 27 ++++++++++++++++---
 3 files changed, 31 insertions(+), 4 deletions(-)

diff --git a/murasalat_office/patches.txt b/murasalat_office/patches.txt
index 21274e5..d999433 100644
