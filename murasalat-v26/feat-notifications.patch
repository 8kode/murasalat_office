<td>\n        <div class=\"role\">{{ FROM_LABEL }}</div>\n        <div class=\"who\">{{ FROM_VALUE or \"—\" }}</div>\n      </td>\n      <td>\n        <div class=\"role\">{{ TO_LABEL }}</div>\n        <div class=\"who\">{{ TO_VALUE or \"—\" }}</div>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"grid meta\">\n    <tr>\n      <td class=\"label\">الموضوع</td>\n      <td class=\"value\" colspan=\"3\">{{ doc.subject or \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">رقم المعاملة</td>\n      <td class=\"value\">{{ doc.name }}</td>\n      <td class=\"label\">تاريخ التسجيل في النظام</td>\n      <td class=\"value\">{{ frappe.utils.getdate(doc.creation).strftime(\"%d-%m-%Y\") if doc.creation else \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">الرقم الخارجي</td>\n      <td class=\"value\">{{ doc.external_letter_number or \"—\" }}</td>\n      <td class=\"label\">تاريخ الخطاب الخارجي</td>\n      <td class=\"value\">{{ frappe.utils.getdate(doc.external_letter_date).strftime(\"%d-%m-%Y\") if doc.external_letter_date else \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">الموعد النهائي</td>\n      <td class=\"value\">{{ frappe.utils.getdate(doc.due_date).strftime(\"%d-%m-%Y\") if doc.due_date else \"—\" }}</td>\n      <td class=\"label\">عدد الصفحات</td>\n      <td class=\"value\">{{ doc.page_count or \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">القسم الحائز حاليًا</td>\n      <td class=\"value\">{{ doc.current_holder or \"—\" }}</td>\n      <td class=\"label\">المعني بالمعاملة</td>\n      <td class=\"value\">{{ doc.concerned_person or \"—\" }}</td>\n    </tr>\n  </table>\n\n  <div class=\"section-title\">المضمون</div>\n  <div class=\"body-box\">{{ doc.notes or \"—\" }}</div>\n\n  {% if doc.attachments %}\n  <div class=\"section-title\">المرفقات ({{ doc.attachments | length }})</div>\n  <table class=\"grid\">\n    <tr>\n      <th style=\"width: 8mm\">#</th>\n      <th style=\"width: 32mm\">النوع</th>\n      <th>الم