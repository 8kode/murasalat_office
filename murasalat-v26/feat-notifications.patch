+        function.group(0),
+        json.dumps(current),
+        json.dumps(incoming),
+    )
+    done = subprocess.run([NODE, "-e", program], capture_output=True, text=True)
+
+    assert done.returncode == 0, done.stderr
+    return json.loads(done.stdout)
+
+
+# --- the hook the panel actually fires ----------------------------------------------
