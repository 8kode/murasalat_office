gn: bottom; padding: 0 0 2mm 0; }\n  .mo-print .title { font-size: 15pt; font-weight: bold; color: #123c35; }\n  .mo-print .subtitle { font-size: 9.5pt; color: #55655f; }\n  .mo-print .doc-no { direction: ltr; text-align: left; font-size: 13pt; font-weight: bold; color: #123c35; letter-spacing: 0.4pt; }\n  .mo-print .badges { margin: 3mm 0 4mm 0; }\n  .mo-print .badge {\n    display: inline-block; border: 0.9pt solid #123c35; border-radius: 2pt;\n    padding: 0.6mm 2.6mm; margin-left: 2mm; font-size: 9pt; font-weight: bold;\n  }\n  .mo-print .badge.plain { border-color: #8fa39c; color: #3c4a45; font-weight: normal; }\n  .mo-print .badge.alert { border-color: #b03a2e; color: #b03a2e; background: #fdf3f1; }\n\n  .mo-print table.grid { width: 100%; border-collapse: collapse; margin: 0 0 4mm 0; }\n  .mo-print table.grid th {\n    background: #eef3f1; color: #123c35; text-align: right; font-size: 9.4pt;\n    border: 0.6pt solid #c9d8d3; padding: 1.6mm 2mm; font-weight: bold;\n  }\n  .mo-print table.grid td { border: 0.6pt solid #c9d8d3; padding: 1.6mm 2mm; vertical-align: top; }\n  .mo-print table.meta td.label { background: #f6f9f8; width: 22%; font-size: 9.2pt; color: #3c4a45; }\n  .mo-print table.meta td.value { width: 28%; font-weight: bold; }\n  .mo-print .mono { direction: ltr; text-align: left; font-family: \"DejaVu Sans Mono\", Consolas, monospace; font-size: 8.2pt; }\n\n  .mo-print .section-title {\n    font-size: 11pt; font-weight: bold; color: #123c35; margin: 4mm 0 1.5mm 0;\n    border-right: 3pt solid #2f6b5f; padding-right: 2mm;\n  }\n  .mo-print .body-box {\n    border: 0.6pt solid #c9d8d3; background: #fbfdfc; padding: 3mm 3.5mm; min-height: 26mm;\n    white-space: pre-wrap;\n  }\n  .mo-print .parties td { text-align: center; width: 50%; }\n  .mo-print .parties .role { font-size: 9pt; color: #55655f; }\n  .mo-print .parties .who { font-size: 11pt; font-weight: bold; }\n\n  .mo-print table.sign { width: 100%; border-collapse: separate; border-spacing: 2.5mm 0; margin-top: 2mm; }\n  .mo-print table.sign td { border: 0.6pt solid #c9d8d3; padding: 2mm; vertical-align: top; width: 33.3%; }\n  .mo-print .sign-role { font-size: 9pt; color: #3c4a45; font-weight: bold; }\n  .mo-print .sign-space { height: 15mm; }\n  .mo-print .sign-line { border-top: 0.6pt solid #8fa39c; font-size: 8.4pt; color: #55655f; padding-top: 1mm; }\n\n  .mo-print .audit { margin-top: 4mm; border: 0.9pt solid #123c35; background: #f4f8f6; padding: 3mm 3.5mm; font-size: 9pt; }\n  .mo-print .audit .hash { direction: ltr; text-align: left; word-break: break-all; font-family: \"DejaVu Sans Mono\", Consolas, monospace; font-size: 7.6pt; }\n  .mo-print .trail { font-size: 8.6pt; }\n  .mo-print .trail th { font-size: 8.6pt; }\n  .mo-print .foot { margin-top: 5mm; border-top: 0.6pt solid #c9d8d3; padding-top: 1.5mm; font-size: 8.2pt; color: #55655f; }\n  .mo-print .muted { color: #7b8b86; }\n</style>\n\n<div class=\"mo-print\" dir=\"rtl\">\n\n  <table class=\"head\">\n    <tr>\n      <td>\n        <div class=\"title\">معاملة</div>\n        <div class=\"subtitle\">{{ doc.correspondence_direction and DIRECTION_AR.get(doc.correspondence_direction, doc.correspondence_direction) or \"\" }}</div>\n      </td>\n      <td class=\"doc-no\">{{ doc.name }}</td>\n    </tr>\n  </table>\n\n  <div class=\"badges\">\n    {% if doc.confidentiality %}<span class=\"badge\">{{ doc.confidentiality }}</span>{% endif %}\n    {% if doc.importance %}<span class=\"badge plain\">{{ doc.importance }}</span>{% endif %}\n    {% if doc.transaction_type %}<span class=\"badge plain\">{{ doc.transaction_type }}</span>{% endif %}\n    {% if doc.workflow_state %}<span class=\"badge plain\">{{ doc.workflow_state }}</span>{% endif %}\n    {% if doc.record_sealed_on %}<span class=\"badge alert\">مختومة</span>{% endif %}\n  </div>\n\n  <table class=\"grid parties\">\n    <tr>\n      <td>\n        <div class=\"role\">{{ FROM_LABEL }}</div>\n        <div class=\"who\">{{ FROM_VALUE or \"—\" }}</div>\n      </td>\n      <td>\n        <div class=\"role\">{{ TO_LABEL }}</div>\n        <div class=\"who\">{{ TO_VALUE or \"—\" }}</div>\n      </td>\n    </tr>\n  </table>\n\n  <table class=\"grid meta\">\n    <tr>\n      <td class=\"label\">الموضوع</td>\n      <td class=\"value\" colspan=\"3\">{{ doc.subject or \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">رقم المعاملة</td>\n      <td class=\"value\">{{ doc.name }}</td>\n      <td class=\"label\">تاريخ التسجيل في النظام</td>\n      <td class=\"value\">{{ frappe.utils.getdate(doc.creation).strftime(\"%d-%m-%Y\") if doc.creation else \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">الرقم الخارجي</td>\n      <td class=\"value\">{{ doc.external_letter_number or \"—\" }}</td>\n      <td class=\"label\">تاريخ الخطاب الخارجي</td>\n      <td class=\"value\">{{ frappe.utils.getdate(doc.external_letter_date).strftime(\"%d-%m-%Y\") if doc.external_letter_date else \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">الموعد النهائي</td>\n      <td class=\"value\">{{ frappe.utils.getdate(doc.due_date).strftime(\"%d-%m-%Y\") if doc.due_date else \"—\" }}</td>\n      <td class=\"label\">عدد الصفحات</td>\n      <td class=\"value\">{{ doc.page_count or \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">القسم الحائز حاليًا</td>\n      <td class=\"value\">{{ doc.current_holder or \"—\" }}</td>\n      <td class=\"label\">المعني بالمعاملة</td>\n      <td class=\"value\">{{ doc.concerned_person or \"—\" }}</td>\n    </tr>\n  </table>\n\n  <div class=\"section-title\">المضمون</div>\n  <div class=\"body-box\">{{ doc.notes or \"—\" }}</div>\n\n  {% if doc.attachments %}\n  <div class=\"section-title\">المرفقات ({{ doc.attachments | length }})</div>\n  <table class=\"grid\">\n    <tr>\n      <th style=\"width: 8mm\">#</th>\n      <th style=\"width: 32mm\">النوع</th>\n      <th>الملف</th>\n      <th style=\"width: 20mm\">سرّي</th>\n    </tr>\n    {% for att in doc.attachments %}\n    <tr>\n      <td>{{ loop.index }}</td>\n      <td>{{ att.attachment_type or \"—\" }}</td>\n      <td>\n        {% if att.is_secret %}\n          <span class=\"muted\">مرفق سرّي — يُطلب من الأرشيف</span>\n        {% elif att.file %}\n          {{ att.file.split(\"/\")[-1] }}\n        {% else %}\n          <span class=\"muted\">—</span>\n        {% endif %}\n      </td>\n      <td>{{ \"نعم\" if att.is_secret else \"لا\" }}</td>\n    </tr>\n    {% endfor %}\n  </table>\n  {% endif %}\n\n  <table class=\"sign\">\n    <tr>\n      <td>\n        <div class=\"sign-role\">الموظف المُحرِّر</div>\n        <div class=\"sign-space\"></div>\n        <div class=\"sign-line\">الاسم والتوقيع والتاريخ</div>\n      </td>\n      <td>\n        <div class=\"sign-role\">المستلِم</div>\n        <div class=\"sign-space\"></div>\n        <div class=\"sign-line\">الاسم والتوقيع والتاريخ</div>\n      </td>\n      <td>\n        <div class=\"sign-role\">الختم الرسمي</div>\n        <div class=\"sign-space\"></div>\n        <div class=\"sign-line\">حسب الأصول</div>\n      </td>\n    </tr>\n  </table>\n\n  {% if doc.record_sealed_on %}\n  <div class=\"audit\">\n    <div class=\"sign-role\">تدقيق السلامة — سجل مختوم</div>\n    <table class=\"grid meta\" style=\"margin: 2mm 0 0 0\">\n      <tr>\n        <td class=\"label\">تاريخ الختم</td>\n        <td class=\"value\">{{ frappe.utils.get_datetime(doc.record_sealed_on).strftime(\"%d-%m-%Y %H:%M\") }}</td>\n        <td class=\"label\">خُتم بواسطة</td>\n        <td class=\"value\">{{ doc.record_sealed_by or \"—\" }}</td>\n      </tr>\n      {% if doc.seal_reason %}\n      <tr>\n        <td class=\"label\">سبب الختم</td>\n        <td class=\"value\" colspan=\"3\">{{ doc.seal_reason }}</td>\n      </tr>\n      {% endif %}\n      {% if doc.reopened_on %}\n      <tr>\n        <td class=\"label\">أُعيد فتحها في</td>\n        <td class=\"value\">{{ frappe.utils.get_datetime(doc.reopened_on).strftime(\"%d-%m-%Y %H:%M\") }}</td>\n        <td class=\"label\">بواسطة</td>\n        <td class=\"value\">{{ doc.reopened_by or \"—\" }}</td>\n      </tr>\n      {% endif %}\n    </table>\n    {% if doc.integrity_hash %}\n    <div style=\"margin-top: 2mm\">بصمة السلامة (SHA-256):</div>\n    <div class=\"hash\">{{ doc.integrity_hash }}</div>\n    {% endif %}\n  </div>\n  {% endif %}\n\n  {% if doc.activities %}\n  <div class=\"section-title\">سجل الحركة</div>\n  <table class=\"grid trail\">\n    <tr>\n      <th style=\"width: 30mm\">التاريخ</th>\n      <th style=\"width: 28mm\">الحدث</th>\n      <th style=\"width: 40mm\">المنفّذ</th>\n      <th>التفصيل</th>\n    </tr>\n    {% for a in doc.activities %}\n    <tr>\n      <td class=\"mono\">{{ frappe.utils.get_datetime(a.activity_on).strftime(\"%d-%m-%Y %H:%M\") if a.activity_on else \"—\" }}</td>\n      <td>{{ ACTIVITY_AR.get(a.activity_type, a.activity_type) }}</td>\n      <td>{{ a.actor or \"—\" }}</td>\n      <td>{{ a.details or \"—\" }}</td>\n    </tr>\n    {% endfor %}\n  </table>\n  {% endif %}\n\n  <div class=\"foot\">\n    طُبع بواسطة {{ frappe.session.user }} — {{ frappe.utils.get_datetime(frappe.utils.now()).strftime(\"%d-%m-%Y %H:%M\") }}\n    {% if doc.correspondence_direction %} · اتجاه المعاملة: {{ DIRECTION_AR.get(doc.correspondence_direction, doc.correspondence_direction) }}{% endif %}\n  </div>\n\n</div>\n",
