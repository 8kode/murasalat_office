- "html": "{# إشعار إحالة — Murasalat Referral notification handed to the recipient.\n\n   Arabic-first on purpose (see the correspondence format). The parent correspondence is\n   read through a permission check so a print never exposes a file the printing user\n   cannot open; a restricted parent prints as مقيّد.\n#}\n{% set DIRECTION_AR = {\"Incoming\": \"وارد\", \"Outgoing\": \"صادر\", \"Internal\": \"داخلي\"} %}\n{% set RECIPIENT_TYPE_AR = {\"User\": \"مستخدم\", \"Department\": \"قسم\"} %}\n{% set can_read_parent = frappe.has_permission(\"Murasalat Correspondence\", doc=doc.correspondence, ptype=\"read\") %}\n{% set parent_subject = frappe.db.get_value(\"Murasalat Correspondence\", doc.correspondence, \"subject\") if (can_read_parent and doc.correspondence) else None %}\n{% set parent_body = frappe.db.get_value(\"Murasalat Correspondence\", doc.correspondence, \"notes\") if (can_read_parent and doc.correspondence) else None %}\n{% set parent_direction = frappe.db.get_value(\"Murasalat Correspondence\", doc.correspondence, \"correspondence_direction\") if (can_read_parent and doc.correspondence) else None %}\n{% set today = frappe.utils.getdate(frappe.utils.today()) %}\n{% set due = frappe.utils.getdate(doc.due_date) if doc.due_date else None %}\n{% set days_left = (due - today).days if due else None %}\n<style>\n  @page { size: A4; margin: 12mm; }\n\n  .mo-print {\n    direction: rtl;\n    text-align: right;\n    font-family: \"Noto Naskh Arabic\", \"Amiri\", \"Traditional Arabic\", \"Segoe UI\", Tahoma, Arial, sans-serif;\n    color: #17231f;\n    font-size: 10.5pt;\n    line-height: 1.75;\n  }\n  .mo-print .head { width: 100%; border-collapse: collapse; border-bottom: 2.2pt solid #123c35; }\n  .mo-print .head td { border: none; vertical-align: bottom; padding: 0 0 2mm 0; }\n  .mo-print .title { font-size: 15pt; font-weight: bold; color: #123c35; }\n  .mo-print .subtitle { font-size: 9.5pt; color: #55655f; }\n  .mo-print .doc-no { direction: ltr; text-align: left; font-size: 13pt; font-weight: bold; color: #123c35; letter-spacing: 0.4pt; }\n  .mo-print .badges { margin: 3mm 0 4mm 0; }\n  .mo-print .badge {\n    display: inline-block; border: 0.9pt solid #123c35; border-radius: 2pt;\n    padding: 0.6mm 2.6mm; margin-left: 2mm; font-size: 9pt; font-weight: bold;\n  }\n  .mo-print .badge.plain { border-color: #8fa39c; color: #3c4a45; font-weight: normal; }\n  .mo-print .badge.alert { border-color: #b03a2e; color: #b03a2e; background: #fdf3f1; }\n  .mo-print .badge.private { border-color: #6b1f18; color: #6b1f18; background: #f7e9e7; }\n  .mo-print table.grid { width: 100%; border-collapse: collapse; margin: 0 0 4mm 0; }\n  .mo-print table.grid th {\n    background: #eef3f1; color: #123c35; text-align: right; font-size: 9.4pt;\n    border: 0.6pt solid #c9d8d3; padding: 1.6mm 2mm; font-weight: bold;\n  }\n  .mo-print table.grid td { border: 0.6pt solid #c9d8d3; padding: 1.6mm 2mm; vertical-align: top; }\n  .mo-print table.meta td.label { background: #f6f9f8; width: 22%; font-size: 9.2pt; color: #3c4a45; }\n  .mo-print table.meta td.value { width: 28%; font-weight: bold; }\n  .mo-print .mono { direction: ltr; text-align: left; font-family: \"DejaVu Sans Mono\", Consolas, monospace; font-size: 8.2pt; }\n  .mo-print .section-title {\n    font-size: 11pt; font-weight: bold; color: #123c35; margin: 4mm 0 1.5mm 0;\n    border-right: 3pt solid #2f6b5f; padding-right: 2mm;\n  }\n  .mo-print .to-box { border: 1.2pt solid #123c35; padding: 3mm 3.5mm; margin-bottom: 4mm; }\n  .mo-print .to-box .role { font-size: 9pt; color: #55655f; }\n  .mo-print .to-box .who { font-size: 12.5pt; font-weight: bold; }\n  .mo-print .instr { border: 0.6pt solid #c9d8d3; background: #fbfdfc; padding: 3.5mm; min-height: 22mm; white-space: pre-wrap; }\n  .mo-print .body-excerpt { border: 0.6pt solid #c9d8d3; background: #f8faf9; padding: 3mm 3.5mm; white-space: pre-wrap; font-size: 9.6pt; }\n  .mo-print .cut { margin-top: 6mm; border-top: 1pt dashed #8fa39c; padding-top: 2mm; font-size: 8.6pt; color: #55655f; }\n  .mo-print table.sign { width: 100%; border-collapse: separate; border-spacing: 2.5mm 0; margin-top: 2mm; }\n  .mo-print table.sign td { border: 0.6pt solid #c9d8d3; padding: 2mm; vertical-align: top; width: 33.3%; }\n  .mo-print .sign-role { font-size: 9pt; color: #3c4a45; font-weight: bold; }\n  .mo-print .sign-space { height: 14mm; }\n  .mo-print .sign-line { border-top: 0.6pt solid #8fa39c; font-size: 8.4pt; color: #55655f; padding-top: 1mm; }\n  .mo-print .foot { margin-top: 5mm; border-top: 0.6pt solid #c9d8d3; padding-top: 1.5mm; font-size: 8.2pt; color: #55655f; }\n  .mo-print .muted { color: #7b8b86; }\n</style>\n\n<div class=\"mo-print\" dir=\"rtl\">\n\n  <table class=\"head\">\n    <tr>\n      <td>\n        <div class=\"title\">إشعار إحالة</div>\n        <div class=\"subtitle\">يُسلَّم إلى الجهة أو الموظف المختص ويُعاد موقّعًا</div>\n      </td>\n      <td class=\"doc-no\">{{ doc.referral_number or doc.name }}</td>\n    </tr>\n  </table>\n\n  <div class=\"badges\">\n    {% if doc.private_referral %}<span class=\"badge private\">خاص</span>{% endif %}\n    {% if days_left is not none and days_left < 0 %}<span class=\"badge alert\">متأخرة {{ -days_left }} يومًا</span>\n    {% elif days_left == 0 %}<span class=\"badge alert\">تستحق اليوم</span>\n    {% elif days_left is not none and days_left <= 2 %}<span class=\"badge alert\">تستحق خلال {{ days_left }} يوم</span>{% endif %}\n    {% if doc.importance %}<span class=\"badge plain\">{{ doc.importance }}</span>{% endif %}\n    {% if doc.follow_up %}<span class=\"badge plain\">للمتابعة</span>{% endif %}\n    {% if doc.paper_copy %}<span class=\"badge plain\">نسخة ورقية</span>{% endif %}\n    {% if doc.cc_copy %}<span class=\"badge plain\">صورة للعلم</span>{% endif %}\n  </div>\n\n  <div class=\"to-box\">\n    <div class=\"role\">الموجَّه إليه — {{ RECIPIENT_TYPE_AR.get(doc.recipient_type, doc.recipient_type) }}</div>\n    <div class=\"who\">{{ doc.recipient_user or doc.recipient_department or \"—\" }}</div>\n  </div>\n\n  <table class=\"grid meta\">\n    <tr>\n      <td class=\"label\">رقم الإحالة</td>\n      <td class=\"value\">{{ doc.referral_number or doc.name }}</td>\n      <td class=\"label\">المعاملة المرجعية</td>\n      <td class=\"value\">{{ doc.correspondence or \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">موضوع المعاملة</td>\n      <td class=\"value\" colspan=\"3\">\n        {% if parent_subject %}{{ parent_subject }}\n        {% elif doc.correspondence %}<span class=\"muted\">مقيّد — لا تملك صلاحية قراءة هذه المعاملة</span>\n        {% else %}—{% endif %}\n      </td>\n    </tr>\n    <tr>\n      <td class=\"label\">اتجاه الإحالة</td>\n      <td class=\"value\">{{ doc.direction or \"—\" }}</td>\n      <td class=\"label\">اتجاه المعاملة</td>\n      <td class=\"value\">{{ DIRECTION_AR.get(parent_direction, parent_direction) if parent_direction else \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">تاريخ الإرسال</td>\n      <td class=\"value\">{{ frappe.utils.get_datetime(doc.sent_on).strftime(\"%d-%m-%Y %H:%M\") if doc.sent_on else \"—\" }}</td>\n      <td class=\"label\">الموعد النهائي</td>\n      <td class=\"value\">{{ due.strftime(\"%d-%m-%Y\") if due else \"—\" }}</td>\n    </tr>\n    {% if doc.received_on %}\n    <tr>\n      <td class=\"label\">تاريخ الاستلام</td>\n      <td class=\"value\">{{ frappe.utils.get_datetime(doc.received_on).strftime(\"%d-%m-%Y %H:%M\") }}</td>\n      <td class=\"label\">استلمها</td>\n      <td class=\"value\">{{ doc.received_by or \"—\" }}</td>\n    </tr>\n    {% endif %}\n    {% if doc.completed_on %}\n    <tr>\n      <td class=\"label\">تاريخ الإكمال</td>\n      <td class=\"value\">{{ frappe.utils.get_datetime(doc.completed_on).strftime(\"%d-%m-%Y %H:%M\") }}</td>\n      <td class=\"label\">أكملها</td>\n      <td class=\"value\">{{ doc.completed_by or \"—\" }}</td>\n    </tr>\n    {% endif %}\n  </table>\n\n  <div class=\"section-title\">التعليمات إلى المستلِم</div>\n  <div class=\"instr\">{{ doc.instructions or \"—\" }}</div>\n\n  {% if can_read_parent and parent_body %}\n  <div class=\"section-title\">مضمون المعاملة (للعلم)</div>\n  <div class=\"body-excerpt\">{{ parent_body }}</div>\n  {% endif %}\n\n  <table class=\"sign\">\n    <tr>\n      <td>\n        <div class=\"sign-role\">توقيع المُرسِل / الجهة المُحيلة</div>\n        <div class=\"sign-space\"></div>\n        <div class=\"sign-line\">الاسم والتوقيع والتاريخ</div>\n      </td>\n      <td>\n        <div class=\"sign-role\">إقرار المستلِم بالاستلام</div>\n        <div class=\"sign-space\"></div>\n        <div class=\"sign-line\">الاسم والتوقيع والتاريخ</div>\n      </td>\n      <td>\n        <div class=\"sign-role\">ملاحظات المستلِم</div>\n        <div class=\"sign-space\"></div>\n        <div class=\"sign-line\">ما تم إنجازه / ما يلزم</div>\n      </td>\n    </tr>\n  </table>\n\n  <div class=\"cut\">\n    قُصّ هنا وأعِد الشريط الموقّع إلى مكتب المراسلات — الإحالة {{ doc.referral_number or doc.name }}\n    {% if doc.correspondence %} المعاملة {{ doc.correspondence }}{% endif %}\n  </div>\n\n  <div class=\"foot\">\n    طُبع بواسطة {{ frappe.session.user }} — {{ frappe.utils.get_datetime(frappe.utils.now()).strftime(\"%d-%m-%Y %H:%M\") }}\n    {% if doc.workflow_state %} · الحالة: {{ doc.workflow_state }}{% endif %}\n  </div>\n\n</div>\n",
