5mm; white-space: pre-wrap; font-size: 9.6pt; }\n  .mo-print .cut { margin-top: 6mm; border-top: 1pt dashed #8fa39c; padding-top: 2mm; font-size: 8.6pt; color: #55655f; }\n  .mo-print table.sign { width: 100%; border-collapse: separate; border-spacing: 2.5mm 0; margin-top: 2mm; }\n  .mo-print table.sign td { border: 0.6pt solid #c9d8d3; padding: 2mm; vertical-align: top; width: 33.3%; }\n  .mo-print .sign-role { font-size: 9pt; color: #3c4a45; font-weight: bold; }\n  .mo-print .sign-space { height: 14mm; }\n  .mo-print .sign-line { border-top: 0.6pt solid #8fa39c; font-size: 8.4pt; color: #55655f; padding-top: 1mm; }\n  .mo-print .foot { margin-top: 5mm; border-top: 0.6pt solid #c9d8d3; padding-top: 1.5mm; font-size: 8.2pt; color: #55655f; }\n  .mo-print .muted { color: #7b8b86; }\n</style>\n\n<div class=\"mo-print\" dir=\"rtl\">\n\n  <table class=\"head\">\n    <tr>\n      <td>\n        <div class=\"title\">إشعار إحالة</div>\n        <div class=\"subtitle\">يُسلَّم إلى الجهة أو الموظف المختص ويُعاد موقّعًا</div>\n      </td>\n      <td class=\"doc-no\">{{ doc.referral_number or doc.name }}</td>\n    </tr>\n  </table>\n\n  <div class=\"badges\">\n    {% if doc.private_referral %}<span class=\"badge private\">خاص</span>{% endif %}\n    {% if days_left is not none and days_left < 0 %}<span class=\"badge alert\">متأخرة {{ -days_left }} يومًا</span>\n    {% elif days_left == 0 %}<span class=\"badge alert\">تستحق اليوم</span>\n    {% elif days_left is not none and days_left <= 2 %}<span class=\"badge alert\">تستحق خلال {{ days_left }} يوم</span>{% endif %}\n    {% if doc.importance %}<span class=\"badge plain\">{{ doc.importance }}</span>{% endif %}\n    {% if doc.follow_up %}<span class=\"badge plain\">للمتابعة</span>{% endif %}\n    {% if doc.paper_copy %}<span class=\"badge plain\">نسخة ورقية</span>{% endif %}\n    {% if doc.cc_copy %}<span class=\"badge plain\">صورة للعلم</span>{% endif %}\n  </div>\n\n  <div class=\"to-box\">\n    <div class=\"role\">الموجَّه إليه — {{ RECIPIENT_TYPE_AR.get(doc.recipient_type, doc.recipient_type) }}</div>\n    <div class=\"who\">{{ doc.recipient_user or doc.recipient_department or \"—\" }}</div>\n  </div>\n\n  <table class=\"grid meta\">\n    <tr>\n      <td class=\"label\">رقم الإحالة</td>\n      <td class=\"value\">{{ doc.referral_number or doc.name }}</td>\n      <td class=\"label\">المعاملة المرجعية</td>\n      <td class=\"value\">{{ doc.correspondence or \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">موضوع المعاملة</td>\n      <td class=\"value\" colspan=\"3\">\n        {% if parent_subject %}{{ parent_subject }}\n        {% elif doc.correspondence %}<span class=\"muted\">مقيّد — لا تملك صلاحية قراءة هذه المعاملة</span>\n        {% else %}—{% endif %}\n      </td>\n    </tr>\n    <tr>\n      <td class=\"label\">اتجاه الإحالة</td>\n      <td class=\"value\">{{ doc.direction or \"—\" }}</td>\n      <td class=\"label\">اتجاه المعاملة</td>\n      <td class=\"value\">{{ DIRECTION_AR.get(parent_direction, parent_direction) if parent_direction else \"—\" }}</td>\n    </tr>\n    <tr>\n      <td class=\"label\">تاريخ الإرسال</td>\n      <td class=\"value\">{{ frappe.utils.get_datetime(doc.sent_on).strftime(\"%d-%m-%Y %H:%M\") if doc.sent_on else \"—\" }}</td>\n      <td class=\"label\">الموعد النهائي</td>\n      <td class=\"value\">{{ due.strftime(\"%d-%m-%Y\") if due else \"—\" }}</td>\n    </tr>\n    {% if doc.received_on %}\n    <tr>\n      <td class=\"label\">تاريخ الاستلام</td>\n      <td class=\"value\">{{ frappe.utils.get_datetime(doc.received_on).strftime(\"%d-%m-%Y %H:%M\") }}</td>\n      <td class=\"label\">استلمها</td>\n      <td class=\"value\">{{ doc.received_by or \"—\" }}</td>\n    </tr>\n    {% endif %}\n    {% if doc.completed_on %}\n    <tr>\n      <td class=\"label\">تاريخ الإكمال</td>\n      <td class=\"value\">{{ frappe.utils.get_datetime(doc.completed_on).strftime(\"%d-%m-%Y %H:%M\") }}</td>\n      <td class=\"label\">أكملها</td>\n      <td class=\"value\">{{ doc.completed_by or \"—\" }}</td>\n    </tr>\n    {% endif %}\n  </table>\n\n  <div class=\"section-title\">التعليمات إلى المستلِم</div>\n  <div class=\"instr\">{{ doc.instructions or \"—\" }}</div>\n\n  {% if can_read_parent and parent_body %}\n  <div class=\"section-title\">مضمون المعاملة (للعلم)</div>\n  <div class=\"body-excerpt\">{{ parent_body }}</div>\n  {% endif %}\n\n  {% if doc.attachments %}\n  {% set secret_count = doc.attachments | selectattr(\"is_secret\") | list | length %}\n  <div class=\"section-title\">المرفقات المرفوعة مع الإحالة ({{ doc.attachments | length }}){% if secret_count %} — منها {{ secret_count }} سرّي{% endif %}</div>\n  <table class=\"grid\">\n    <tr>\n      <th style=\"width: 8mm\">#</th>\n      <th style=\"width: 32mm\">النوع</th>\n      <th>الملف</th>\n      <th style=\"width: 20mm\">سرّي</th>\n    </tr>\n    {% for att in doc.attachments %}\n    <tr>\n      <td>{{ loop.index }}</td>\n      <td>{{ ATTACHMENT_TYPE_AR.get(att.attachment_type, att.attachment_type) or \"—\" }}</td>\n      <td>\n        {% if att.is_secret %}\n          <span class=\"muted\">مرفق سرّي — يُطلب من الأرشيف</span>\n        {% elif att.file %}\n          {{ att.file.split(\"/\")[-1] }}\n        {% else %}\n          <span class=\"muted\">—</span>\n        {% endif %}\n      </td>\n      <td>{{ \"نعم\" if att.is_secret else \"لا\" }}</td>\n    </tr>\n    {% endfor %}\n  </table>\n  {% if secret_count %}\n  <div class=\"cut\" style=\"margin-top: 1mm; border: none; padding: 0\">\n    المرفقات السرّية لا تُدرَج في الإشعار — تُطلب من الأرشيف وفق الصلاحية.\n  </div>\n  {% endif %}\n  {% endif %}\n\n  <table class=\"sign\">\n    <tr>\n      <td>\n        <div class=\"sign-role\">توقيع المُرسِل / الجهة المُحيلة</div>\n        <div class=\"sign-space\"></div>\n        <div class=\"sign-line\">الاسم والتوقيع والتاريخ</div>\n      </td>\n      <td>\n        <div class=\"sign-role\">إقرار المستلِم بالاستلام</div>\n        <div class=\"sign-space\"></div>\n        <div class=\"sign-line\">الاسم والتوقيع والتاريخ</div>\n      </td>\n      <td>\n        <div class=\"sign-role\">ملاحظات المستلِم</div>\n        <div class=\"sign-space\"></div>\n        <div class=\"sign-line\">ما تم إنجازه / ما يلزم</div>\n      </td>\n    </tr>\n  </table>\n\n  <div class=\"cut\">\n    قُصّ هنا وأعِد الشريط الموقّع إلى مكتب المراسلات — الإحالة {{ doc.referral_number or doc.name }}\n    {% if doc.correspondence %} المعاملة {{ doc.correspondence }}{% endif %}\n  </div>\n\n  <div class=\"foot\">\n    طُبع بواسطة {{ frappe.session.user }} — {{ frappe.utils.get_datetime(frappe.utils.now()).strftime(\"%d-%m-%Y %H:%M\") }}\n    {% if doc.workflow_state %} · الحالة: {{ doc.workflow_state }}{% endif %}\n  </div>\n\n</div>\n",
