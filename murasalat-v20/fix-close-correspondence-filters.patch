From fac4650c43ba207b2988733bd911d1478b13eb32 Mon Sep 17 00:00:00 2001
From: genspark_dev <genspark_dev@genspark.ai>
Date: Thu, 24 Sep 2026 02:49:30 +0300
Subject: [PATCH] Close a correspondence again: its filter list was unpacked as
 a mapping

Closing any correspondence failed with "'list' object is not a mapping". The
open-referral filter is a list of [fieldname, operator, value] triples and every
other call site spreads it with a star, but this one unpacked it into a dict with
a double star. The query never ran, so closing a file was broken on every branch,
and the check that refuses to close a file with open referrals had never actually
executed.

Spread it into the filter list, and pin both the filter shape and the refusal with
tests that run the function rather than reading its source.
---
 murasalat_office/services/lifecycle.py        | 11 ++--
 .../tests/test_referral_cancellation.py       | 51 +++++++++++++++++++
 2 files changed, 58 insertions(+), 4 deletions(-)

diff --git a/murasalat_office/services/lifecycle.py b/murasalat_office/services/lifecycle.py
index 47c1d8d..aa9cf53 100644
--- a/murasalat_office/services/lifecycle.py
+++ b/murasalat_office/services/lifecycle.py
@@ -53,10 +53,13 @@ def _get_open_referrals(correspondence_name):
     """
     return frappe.get_all(
         "Murasalat Referral",
-        filters={
-            "correspondence": correspondence_name,
-            **OPEN_REFERRAL_FILTERS,
-        },
+        # OPEN_REFERRAL_FILTERS is a list of [fieldname, operator, value] triples, so it
+        # spreads into the filter list. It is not a mapping: unpacking it with ** raised
+        # "'list' object is not a mapping" and closing a correspondence could never work.
+        filters=[
+            ["correspondence", "=", correspondence_name],
+            *OPEN_REFERRAL_FILTERS,
+        ],
         fields=["name"],
         order_by="due_date asc, modified desc",
         limit_page_length=0,
diff --git a/murasalat_office/tests/test_referral_cancellation.py b/murasalat_office/tests/test_referral_cancellation.py
index 14f2e82..4197535 100644
--- a/murasalat_office/tests/test_referral_cancellation.py
+++ b/murasalat_office/tests/test_referral_cancellation.py
@@ -163,6 +163,57 @@ def test_cancelling_twice_changes_nothing():
     assert HOLDER["parent"].appended == []
 
 
+def test_closing_reads_its_filters_as_a_list_not_a_mapping():
+    """Closing a correspondence failed with "'list' object is not a mapping".
+
+    OPEN_REFERRAL_FILTERS is a list of triples, so it must spread into a filter list. Any
+    attempt to unpack it as a mapping turns every Close into a TypeError.
+    """
+    lifecycle = _lifecycle()
+    captured = {}
+
+    def fake_get_all(doctype, **kwargs):
+        captured["doctype"] = doctype
+        captured.update(kwargs)
+        return []
+
+    lifecycle.frappe.get_all = fake_get_all
+
+    lifecycle._get_open_referrals("MO-00015")
+
+    filters = captured["filters"]
+    assert captured["doctype"] == "Murasalat Referral"
+    assert isinstance(filters, list), filters
+    assert ["correspondence", "=", "MO-00015"] == filters[0]
+    # every declared open-referral condition survives into the query
+    for condition in lifecycle.OPEN_REFERRAL_FILTERS:
+        assert condition in filters, condition
+
+
+def test_closing_a_correspondence_with_open_referrals_is_refused():
+    """The filter has to actually reach the query for the refusal to be meaningful."""
+    lifecycle = _lifecycle()
+    captured = {}
+
+    def fake_get_all(doctype, **kwargs):
+        captured.update(kwargs)
+        return [{"name": "MR-00019"}]
+
+    lifecycle.frappe.get_all = fake_get_all
+    doc = FakeDoc(
+        doctype="Murasalat Correspondence",
+        closed_on=None,
+        current_holder="ORG-1",
+        name="MO-00015",
+    )
+
+    with pytest.raises(MurasalatThrow):
+        lifecycle.close_correspondence(doc)
+
+    assert isinstance(captured["filters"], list)
+    assert doc.closed_on is None
+
+
 def test_a_cancelled_referral_is_no_longer_open_work():
     """Otherwise a called-off referral would block closing its correspondence forever."""
     lifecycle = _lifecycle()
